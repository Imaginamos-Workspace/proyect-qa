# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-256-bit-encryption-key

# Board scrum (GitHub Projects v2) — para el kanban tipo Jira del portal.
# PAT fine-grained con scope `read:project` (read-only basta para mostrar el board).
GITHUB_TOKEN=your-github-projects-read-token
# Dueño de los Projects (organización dueña de los boards). Default: Imaginamos-Workspace.
GITHUB_PROJECT_OWNER=Imaginamos-Workspace

# Frontend (prefix with VITE_)
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
