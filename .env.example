# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Fallbacks gratis de IA (opcionales) — cuando Gemini flash/pro topan cuota o
# están sobrecargados, GeminiProvider.generateContentWithRetry() sigue con
# estos antes de fallar. Sin ellos, la cascada real es solo Gemini (2 pasos).
# Groq: console.groq.com, gratis, sin tarjeta — límites generosos (Llama 3.3 70B).
GROQ_API_KEY=your-groq-api-key
# DeepSeek: platform.deepseek.com — 5M tokens gratis por cuenta nueva, después de pago.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-256-bit-encryption-key

# Board scrum (GitHub Projects v2) — para el kanban tipo Jira del portal.
# PAT fine-grained con scope `read:project` (read-only basta para mostrar el board).
GITHUB_TOKEN=your-github-projects-read-token
# Dueño de los Projects (organización dueña de los boards). Default: Imaginamos-Workspace.
GITHUB_PROJECT_OWNER=Imaginamos-Workspace
# PAT fine-grained con ESCRITURA (Issues:write, Actions:write, Contents:read-write)
# sobre imaginamos/qa-automation-monorepo. Habilita mover tarjetas, carry-over,
# y el módulo Ventas (escribir brief.md/status.md).
GITHUB_WRITE_TOKEN=your-github-write-token

# Frontend (prefix with VITE_)
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
